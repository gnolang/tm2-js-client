{
  "name": "@gnolang/tm2-js-client",
  "version": "3.1.0",
  "description": "Tendermint2 JS / TS Client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnolang/tm2-js-client.git"
  },
  "keywords": [
    "tm2",
    "tendermint2",
    "sdk",
    "client",
    "js"
  ],
  "author": "Milos Zivkovic <milos.zivkovic@tendermint.com>",
  "license": "Apache-2.0",
  "homepage": "https://gno.land/",
  "files": [
    "dist/",
    "*.md",
    "!*.spec.*",
    "!**/testdata/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "ts-proto": "^2.12.4",
    "tsdown": "^0.23.0",
    "type-fest": "^5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "vitest-websocket-mock": "^0.8.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/ledger-amino": "0.39.0",
    "@gnolang/tm2-rpc": "^2.0.2",
    "@noble/hashes": "^2.4.0",
    "axios": "^1.20.0",
    "protobufjs": "^8.8.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build": "tsc --noEmit && tsdown",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "codegen": "./scripts/generate.sh && pnpm run lint:fix",
    "prepare": "node scripts/install-hooks.mjs && pnpm build",
    "prepublishOnly": "pnpm lint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "packageManager": "pnpm@12.4.2",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
